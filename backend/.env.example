# Server Configuration
PROJECT_NAME="AlgoVision API"
VERSION="1.0.0"
PORT=8000
HOST="0.0.0.0"

# JWT Authentication
JWT_SECRET="algovision_super_secure_jwt_secret_key_2026_change_in_prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# MongoDB Atlas Connection
# If left empty, AlgoVision operates with zero configuration using its resilient in-memory store
MONGODB_URI=""
DATABASE_NAME="algovision_db"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "https://algovision.vercel.app"]
